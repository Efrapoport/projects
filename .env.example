# SerpAPI key for Google Jobs aggregation (free tier: 100 searches/month)
# Sign up at https://serpapi.com — no credit card required
SERPAPI_KEY=

# (Optional) Google Sign-In — enables "Sign in with Google" button
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add your deployed URL to "Authorized JavaScript origins"
#    (e.g. https://your-app.vercel.app — add http://localhost:3000 too for local dev)
# 4. Paste the Client ID below
# Without this, users sign in with a simple name/email prompt instead.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# (Optional) Daily Leads Digest — comma-separated recipient emails
# The /api/digest/daily cron endpoint sends to these addresses.
DIGEST_RECIPIENTS=

# Resend API key for daily digest emails (free tier: 3,000 emails/month)
# Sign up at https://resend.com and create an API key.
RESEND_API_KEY=

# Sender address for digest emails. Must be a verified domain in Resend,
# or use "onboarding@resend.dev" for testing.
DIGEST_FROM_EMAIL=

# (Optional) Cron secret — Vercel sets this automatically for cron jobs.
# Used to protect the /api/digest/daily endpoint from unauthorized access.
CRON_SECRET=
